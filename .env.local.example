# =============================================================================
# Plataforma de Gestión de Stock — Simetra Service SA
# Copiá este archivo a `.env.local` y completá los valores del proyecto
# Supabase `gestion_de_stock` (Settings → API).
# =============================================================================

# URL del proyecto (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Clave anónima / publishable (segura para el cliente, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave service_role (SOLO servidor — nunca exponer al cliente ni al repo)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- EmailJS (invitaciones y recuperación de contraseña) ---
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_INVITACION=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_RECUPERAR=
